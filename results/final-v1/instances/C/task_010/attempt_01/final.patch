 def merge_ranges(ranges: list[tuple[int, int]]) -> list[tuple[int, int]]:
-    raise NotImplementedError
+    """Merge inclusive integer ranges, combining overlaps and touching ranges.
+
+    Ranges are inclusive, so [1, 3] and [4, 5] touch and merge into [1, 5].
+    The input may be unsorted; the result is returned sorted by start.
+    """
+    if not ranges:
+        return []
+
+    merged: list[tuple[int, int]] = []
+    for start, end in sorted(ranges):
+        if merged and start <= merged[-1][1] + 1:
+            # Overlap or touch (inclusive): extend the previous range.
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+
