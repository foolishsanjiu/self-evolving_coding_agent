diff --git a/parallelism/mapping.py b/parallelism/mapping.py
--- a/parallelism/mapping.py
+++ b/parallelism/mapping.py
@@ -18,6 +18,18 @@ def ordered_parallel_map(
     values = list(items)
     if not values:
         return []
-    with executor_factory(max_workers=max_workers) as executor:
